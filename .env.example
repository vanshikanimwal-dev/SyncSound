# Optional overrides. The backend reads these from the process environment.
# In development, unset values use the defaults in backend/app/core/config.py.
# Do not put real secrets in this file. Do not commit a filled-in .env.

APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# SQLite file used when this is blank or unset.
DATABASE_URL=

# Unused by the single-process server. Left here so a later multi-process setup has a name.
REDIS_URL=

# Optional. Without it, YouTube search stays unavailable and users paste a video URL.
YOUTUBE_API_KEY=

# Unused. Spotify is not part of this server.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/integrations/spotify/callback

# Development default is dev-syncsound-change-me. Production refuses that value.
SESSION_SECRET=

ROOM_MAX_PARTICIPANTS=20
ROOM_TTL_MINUTES=240
CREATE_RATE_LIMIT=20
JOIN_RATE_LIMIT=60
HOST_DISCONNECT_GRACE_SECONDS=30

CORS_ORIGINS=http://localhost:5173
